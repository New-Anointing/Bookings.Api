{
  "ConnectionStrings": {
    "Database": "Host=bookings.database;Port=5432;Database=bookings;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "bookings.redis:6379"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {"serverUrl" :  "http://bookings.seq:5341"}
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Bookings.Api"
    }
  }
}
